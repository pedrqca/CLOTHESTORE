generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  price        Int
  image        String
  isNew        Boolean  @default(false)
  categorySlug String
  createdAt    DateTime @default(now())
}